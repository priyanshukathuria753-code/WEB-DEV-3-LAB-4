{
  "info": {
    "name": "Lab 4 - Secure Connect",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "noteId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"123456\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "2. Login (saves token automatically)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var data = pm.response.json();", "if (data.token) { pm.collectionVariables.set('token', data.token); }"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"123456\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "3. Notes WITHOUT token (401)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/notes" }
    },
    {
      "name": "4. Profile WITH token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "5. Create note (saves noteId)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var data = pm.response.json();", "if (data._id) { pm.collectionVariables.set('noteId', data._id); }"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"My first note\",\n  \"content\": \"Hello world\"\n}" },
        "url": "{{baseUrl}}/api/notes"
      }
    },
    {
      "name": "6. Get all my notes",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/notes"
      }
    },
    {
      "name": "7. Update note",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content\"\n}" },
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      }
    },
    {
      "name": "8. Delete note",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      }
    },
    {
      "name": "9. Admin route as normal user (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/admin/users"
      }
    }
  ]
}
